'JSP000530.counterexample_family' depends on axioms: [propext, Classical.choice, Quot.sound]
Palomar654.counterexample_family (parameter : ℕ) :
  ∃ points,
    points.card = 4 * parameter ∧
      Palomar654.NoFourConcyclic points ∧
        ∀ point ∈ points, (Palomar654.distanceValues points point).card < 3 * parameter
Palomar654.not_near_linear :
  ¬∀ (epsilon : ℝ),
      0 < epsilon →
        ∃ cutoff,
          ∀ (points : Finset ℂ),
            cutoff ≤ points.card →
              Palomar654.NoFourConcyclic points →
                ∃ point ∈ points, (1 - epsilon) * ↑points.card ≤ ↑(Palomar654.distanceValues points point).card
Palomar654.third_lower_bound (points : Finset ℂ) (point : ℂ) (noFour : Palomar654.NoFourConcyclic points)
  (point_mem : point ∈ points) : points.card - 1 ≤ 3 * (Palomar654.distanceValues points point).card
'Palomar654.counterexample_family' depends on axioms: [propext, Classical.choice, Quot.sound]
